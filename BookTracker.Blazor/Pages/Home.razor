@page "/"
@page "/booktracker"
@inject NavigationManager NavigationManager

@using BookTracker.Blazor.Components.Books

<PageTitle>BookTracker</PageTitle>

<h1>Book Tracker</h1>

<button @onclick="ToggleAuthors">
    Toon of verberg auteurs
</button>

<BookList ShowAuthor="@showAuthors" OnSelected="SelectBook" />

@code {
    private bool showAuthors = true;

    private int? selectedBookId;

    private void ToggleAuthors()
    {
        showAuthors = !showAuthors;
    }

    private void SelectBook(int bookId)
    {
        NavigationManager.NavigateTo($"/books/{bookId}");
    }
}