@using BookTracker.Blazor.Models.Books

<tr>
    <td><b>Title:</b> @Book.Title</td>

    @if (ShowAuthor)
    {
        <td><b>Author:</b> @Book.Author</td>
    }

    <td>
        <button type="button" @onclick="SelectBook">
            Selecteer
        </button>
    </td>
</tr>

@code {
    [Parameter]
    public required BookSummary Book { get; set; }

    
    [Parameter]
    public bool ShowAuthor { get; set; } = true;

    [Parameter]
    public EventCallback<int> OnSelected { get; set; }

    private Task SelectBook()
    {
        return OnSelected.InvokeAsync(Book.Id);
    }

}